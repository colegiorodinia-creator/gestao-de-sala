{"branch":"main","owner":"colegiorodinia-creator","repo":"gestao-de-sala","message":"Vincular Supabase oficial em login e visao-professor","files":[{"path":"login.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"favicon.svg\">\n    <link rel=\"shortcut icon\" href=\"favicon.ico\">\n    <title>Gestão de Mapa — Acessar o Portal</title>\n    \n    <!-- Phosphor Icons CDN -->\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css\">\n    <script src=\"https://unpkg.com/@phosphor-icons/web@2.1.1\"></script>\n    <script src=\"/assets/js/phosphor.js\"></script>\n    \n    <!-- Supabase Client & Global Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"></script>\n    <script src=\"global.js\"></script>\n    <link rel=\"stylesheet\" href=\"global.css\">\n\n    <style>\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n            font-family: 'Inter', system-ui, -apple-system, sans-serif;\n        }\n\n        body {\n            background: #F1F5F9;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 24px;\n            color: var(--rodin-graphite);\n        }\n\n        .simple-login-card {\n            width: 100%;\n            max-width: 440px;\n            background: #FFFFFF;\n            border-radius: 24px;\n            padding: 40px 36px;\n            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);\n            border: 1px solid var(--rodin-line);\n            text-align: center;\n        }\n\n        .login-logo-img {\n            max-width: 180px;\n            height: auto;\n            margin-bottom: 24px;\n        }\n\n        .login-title {\n            font-size: 22px;\n            font-weight: 800;\n            color: var(--rodin-graphite);\n            margin-bottom: 6px;\n        }\n\n        .login-subtitle {\n            font-size: 13px;\n            color: var(--rodin-cool-gray);\n            margin-bottom: 28px;\n        }\n\n        .form-group-simple {\n            text-align: left;\n            margin-bottom: 18px;\n        }\n\n        .form-group-simple label {\n            display: block;\n            font-size: 11px;\n            font-weight: 800;\n            color: var(--rodin-cool-gray);\n            margin-bottom: 6px;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .input-box {\n            position: relative;\n            display: flex;\n            align-items: center;\n        }\n\n        .input-left-icon {\n            position: absolute;\n            left: 14px;\n            font-size: 20px;\n            color: #64748B;\n            pointer-events: none;\n            z-index: 2;\n        }\n\n        .simple-input {\n            width: 100%;\n            height: 48px;\n            padding: 0 44px 0 44px;\n            border: 1.5px solid var(--rodin-line);\n            border-radius: 12px;\n            font-size: 14px;\n            font-weight: 600;\n            color: var(--rodin-graphite);\n            background: #F8FAFC;\n            outline: none;\n            transition: all 0.2s ease;\n        }\n\n        .simple-input:focus {\n            border-color: var(--rodin-orange);\n            background: #FFFFFF;\n            box-shadow: 0 0 0 3px rgba(244, 82, 6, 0.12);\n        }\n\n        .toggle-password-btn {\n            position: absolute;\n            right: 12px;\n            background: transparent;\n            border: none;\n            color: #64748B;\n            font-size: 20px;\n            cursor: pointer;\n            padding: 6px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 8px;\n            transition: all 0.2s ease;\n            z-index: 2;\n        }\n\n        .toggle-password-btn:hover {\n            color: var(--rodin-orange);\n            background: #FFF7ED;\n        }\n\n        .btn-enter-portal {\n            width: 100%;\n            height: 48px;\n            background: var(--rodin-orange);\n            color: #FFFFFF;\n            border: none;\n            border-radius: 12px;\n            font-size: 15px;\n            font-weight: 800;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n            margin-top: 24px;\n            transition: all 0.2s ease;\n            box-shadow: 0 4px 12px rgba(244, 82, 6, 0.3);\n        }\n\n        .btn-enter-portal:hover {\n            background: #D94300;\n            transform: translateY(-1px);\n        }\n\n        .quick-test-section {\n            margin-top: 24px;\n            padding-top: 20px;\n            border-top: 1px solid var(--rodin-line);\n        }\n\n        .quick-test-label {\n            font-size: 11px;\n            font-weight: 800;\n            color: var(--rodin-cool-gray);\n            margin-bottom: 10px;\n            text-transform: uppercase;\n        }\n\n        .quick-buttons-row {\n            display: flex;\n            gap: 10px;\n        }\n\n        .btn-quick-role {\n            flex: 1;\n            background: #F8FAFC;\n            border: 1px solid var(--rodin-line);\n            border-radius: 10px;\n            padding: 8px;\n            font-size: 11px;\n            font-weight: 700;\n            color: var(--rodin-graphite);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n            transition: all 0.2s ease;\n        }\n\n        .btn-quick-role:hover {\n            background: #FFF7ED;\n            border-color: var(--rodin-orange);\n            color: var(--rodin-orange);\n        }\n\n        .error-msg-box {\n            display: none;\n            background: #FEF2F2;\n            border: 1px solid #FCA5A5;\n            color: #991B1B;\n            padding: 10px 14px;\n            border-radius: 10px;\n            font-size: 12px;\n            font-weight: 600;\n            margin-bottom: 16px;\n            text-align: left;\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"simple-login-card\">\n        <!-- LOGO NO TOPO -->\n        <img src=\"logotipo-colegio-rodin.png\" alt=\"Colégio Rodin\" class=\"login-logo-img\">\n\n        <h1 class=\"login-title\">Acessar o Portal</h1>\n        <p class=\"login-subtitle\">Plataforma de Gestão Pedagógica Rodin</p>\n\n        <div id=\"login-error-msg\" class=\"error-msg-box\"></div>\n\n        <form id=\"form-login-simplificado\" onsubmit=\"executarLoginSimplificado(event)\">\n            <div class=\"form-group-simple\">\n                <label for=\"login-email\">E-mail Institucional</label>\n                <div class=\"input-box\">\n                    <i class=\"ph-bold ph-envelope-simple input-left-icon\"></i>\n                    <input type=\"email\" id=\"login-email\" class=\"simple-input\" placeholder=\"seu.email@colegiorodin.com.br\" required>\n                </div>\n            </div>\n\n            <div class=\"form-group-simple\">\n                <label for=\"login-password\">Senha de Acesso</label>\n                <div class=\"input-box\">\n                    <i class=\"ph-bold ph-lock-simple input-left-icon\"></i>\n                    <input type=\"password\" id=\"login-password\" class=\"simple-input\" placeholder=\"••••••••\" required>\n                    <button type=\"button\" class=\"toggle-password-btn\" onclick=\"toggleSenhaVisivel()\" title=\"Mostrar ou Ocultar Senha\">\n                        <i id=\"eye-icon\" class=\"ph-bold ph-eye\"></i>\n                    </button>\n                </div>\n            </div>\n\n            <button type=\"submit\" id=\"btn-entrar\" class=\"btn-enter-portal\">\n                <span>Entrar no Portal</span>\n                <i class=\"ph-bold ph-arrow-right\"></i>\n            </button>\n        </form>\n    </div>\n\n    <script>\n        function toggleSenhaVisivel() {\n            const passInput = document.getElementById('login-password');\n            const eyeIcon = document.getElementById('eye-icon');\n            if (passInput.type === 'password') {\n                passInput.type = 'text';\n                eyeIcon.className = 'ph-bold ph-eye-slash';\n            } else {\n                passInput.type = 'password';\n                eyeIcon.className = 'ph-bold ph-eye';\n            }\n        }\n\n        function preencherEEntrar(email, senha) {\n            document.getElementById('login-email').value = email;\n            document.getElementById('login-password').value = senha;\n            const errBox = document.getElementById('login-error-msg');\n            if (errBox) errBox.style.display = 'none';\n        }\n\n        async function executarLoginSimplificado(e) {\n            e.preventDefault();\n            const btn = document.getElementById('btn-entrar');\n            const errBox = document.getElementById('login-error-msg');\n            const email = document.getElementById('login-email').value.trim();\n            const password = document.getElementById('login-password').value.trim();\n\n            const emailClean = email.toLowerCase();\n            if (emailClean === 'monitoria' || emailClean === 'monitoria@colegiorodin.com.br' || emailClean === 'monitoria@colegiorodin.edu.br') {\n                if (password === 'Rod!n112358*') {\n                    sessionStorage.setItem('rodin_sala_auth', 'true');\n                    sessionStorage.setItem('rodin_user_role', 'monitoria');\n                    localStorage.setItem('rodin_sala_auth', 'true');\n                    localStorage.setItem('rodin_user_role', 'monitoria');\n                    localStorage.removeItem('rodin_active_session'); // limpa admin para evitar conflito\n                    window.location.href = 'visao-professor-6-ano-a';\n                    return;\n                } else {\n                    if (errBox) {\n                        errBox.textContent = \"Senha incorreta para o usuário de monitoria.\";\n                        errBox.style.display = 'block';\n                    }\n                    return;\n                }\n            }\n\n            btn.disabled = true;\n            btn.innerHTML = `<i class=\"ph-bold ph-spinner\" style=\"animation: spin 1s linear infinite;\"></i> Autenticando no Supabase...`;\n\n            if (errBox) errBox.style.display = 'none';\n\n            try {\n                const perfis = {\n                    'direcao@colegiorodin.com.br': {\n                        id: 'usr_diretor',\n                        email: 'direcao@colegiorodin.com.br',\n                        nome: 'Benedito Donizete Bueno da Silva',\n                        cargo: 'Direção Geral (Admin)',\n                        papel: 'diretor',\n                        turmas_permitidas: 'todas',\n                        foto: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=150&q=80'\n                    },\n                    'orientacao@colegiorodin.com.br': {\n                        id: 'usr_ricardo',\n                        email: 'orientacao@colegiorodin.com.br',\n                        nome: 'Ricardo Augusto Posso',\n                        cargo: 'Orientador Pedagógico (6º e 7º Anos)',\n                        papel: 'orientador',\n                        turmas_permitidas: ['6º Ano A', '6º Ano B', '7º Ano A', '7º Ano B'],\n                        foto: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80'\n                    }\n                };\n\n                const emailLower = email.toLowerCase();\n                const perfilAtivo = perfis[emailLower] || {\n                    id: 'usr_' + Date.now(),\n                    email: emailLower,\n                    nome: emailLower.split('@')[0].replace('.', ' '),\n                    cargo: 'Orientador Pedagógico',\n                    papel: 'orientador',\n                    turmas_permitidas: 'todas',\n                    foto: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80'\n                };\n\n                let usrDb = null;\n                // Buscar dados mais atualizados do usuário na tabela pública\n                if (window.sb && typeof window.sb.from === 'function') {\n                    try {\n                        const { data } = await window.sb.from('usuarios_sistema').select('*').eq('email', emailLower).maybeSingle();\n                        usrDb = data;\n                    } catch(dbErr) {\n                        console.warn(\"Erro ao buscar dados do usuário na tabela pública:\", dbErr);\n                    }\n                }\n\n                // Se o usuário já tem registro e senha customizada no banco:\n                if (usrDb) {\n                    const info = window.obterPermissoesESenhaUsuario(usrDb);\n                    if (info.senha) {\n                        if (password !== info.senha) {\n                            btn.disabled = false;\n                            btn.innerHTML = `<span>Entrar no Portal</span> <i class=\"ph-bold ph-arrow-right\"></i>`;\n                            if (errBox) {\n                                errBox.textContent = \"Senha de acesso incorreta.\";\n                                errBox.style.display = 'block';\n                            }\n                            return;\n                        }\n                    }\n                }\n\n                // POPULAR / AUTENTICAR NO SUPABASE AUTH E TABELA USUARIOS_SISTEMA EM NUVEM\n                if (window.sb) {\n                    try {\n                        // Se não houver uma senha customizada no banco, validar via Supabase Auth\n                        const info = usrDb ? window.obterPermissoesESenhaUsuario(usrDb) : null;\n                        if (!info || !info.senha) {\n                            if (window.sb.auth) {\n                                let { data, error } = await window.sb.auth.signInWithPassword({ email: emailLower, password });\n                                \n                                // Se não existe na tabela auth.users do Supabase, efetuar Auto-SignUp!\n                                if (error && (error.message.includes('Invalid') || error.message.includes('not found') || error.status === 400)) {\n                                    console.log(\"Cadastrando novo usuário no Supabase Auth...\");\n                                    await window.sb.auth.signUp({\n                                        email: emailLower,\n                                        password: password,\n                                        options: {\n                                            data: {\n                                                full_name: perfilAtivo.nome,\n                                                cargo: perfilAtivo.cargo\n                                            }\n                                        }\n                                    });\n                                }\n                            }\n                        }\n\n                        // Sincronizar com a tabela pública usuarios_sistema\n                        if (usrDb) {\n                            perfilAtivo.id = usrDb.id || perfilAtivo.id;\n                            perfilAtivo.nome = usrDb.nome || perfilAtivo.nome;\n                            perfilAtivo.cargo = usrDb.cargo || perfilAtivo.cargo;\n                            perfilAtivo.papel = usrDb.papel || perfilAtivo.papel;\n                            perfilAtivo.turmas_permitidas = usrDb.turmas_permitidas || perfilAtivo.turmas_permitidas;\n                            perfilAtivo.foto = usrDb.foto || perfilAtivo.foto;\n                        } else {\n                            await window.sb.from('usuarios_sistema').upsert([perfilAtivo]);\n                        }\n                    } catch(authErr) {\n                        console.warn(\"Aviso de Autenticação Supabase:\", authErr);\n                    }\n                }\n\n                localStorage.setItem('rodin_active_session', JSON.stringify(perfilAtivo));\n                localStorage.setItem('rodin_usuario_logado_id', perfilAtivo.id);\n                window.location.href = 'analise-geral.html';\n\n            } catch(err) {\n                console.error(\"Erro no login:\", err);\n                if (errBox) {\n                    errBox.textContent = \"Falha ao autenticar. Tente novamente.\";\n                    errBox.style.display = 'block';\n                }\n                btn.disabled = false;\n                btn.innerHTML = `<span>Entrar no Portal</span> <i class=\"ph-bold ph-arrow-right\"></i>`;\n            }\n        }\n    </script>\n</body>\n</html>\n"},{"path":"visao-professor.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <script>\n        window.onerror = function(message, source, lineno, colno, error) {\n            const errDiv = document.createElement('div');\n            errDiv.style.cssText = 'position:fixed; top:0; left:0; right:0; background:#EF4444; color:#FFF; padding:20px; z-index:999999; font-family:monospace; font-size:14px; line-height:1.5; border-bottom:4px solid #B91C1C;';\n            errDiv.innerHTML = '<strong>⚠️ JavaScript Error Detected:</strong><br>' + \n                               'Message: ' + message + '<br>' +\n                               'Source: ' + source + '<br>' +\n                               'Line: ' + lineno + ' | Column: ' + colno;\n            document.documentElement.appendChild(errDiv);\n            return false;\n        };\n    </script>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"favicon.svg\">\n    <link rel=\"shortcut icon\" href=\"favicon.ico\">\n    <title>Gestão de Mapa — Visão de Sala (Professor)</title>\n    \n    <!-- Phosphor Icons CDN -->\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css\">\n    <script src=\"https://unpkg.com/@phosphor-icons/web@2.1.1\"></script>\n    <script src=\"/assets/js/phosphor.js\"></script>\n    \n    <!-- Supabase JS Client & Global Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"></script>\n    <script src=\"global.js\"></script>\n    <link rel=\"stylesheet\" href=\"global.css\">\n\n    <!-- html2pdf.js (Self-Hosted) -->\n    <script src=\"/assets/js/html2pdf.bundle.min.js\"></script>\n\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body style=\"background:#090D16;\">\n\n    <div class=\"app-layout\" id=\"app-layout\">\n        <aside class=\"sidebar-secondary\" id=\"sidebar-secondary\"></aside>\n\n        <main class=\"main-content\">\n            <div class=\"view-scroll-container\" id=\"view-scroll-container\" style=\"padding:0;\">\n                \n                <!-- NÍVEL 2: PROFESSOR / SALA (DARK MODE COMPLETO) -->\n                <div id=\"view-professor\" class=\"view-container active\">\n                    <div class=\"view-professor-dark\" style=\"padding:20px;\">\n                        \n                        <!-- Toolbar Escura do Professor -->\n                        <div class=\"prof-dark-toolbar\" style=\"margin-bottom:16px;\">\n                            <div>\n                                <div class=\"discipline-tag\" id=\"prof-materia-titulo\">Matemática</div>\n                                <div style=\"font-size:13px; font-weight:700; color:var(--rodin-orange); margin-top:2px;\" id=\"prof-nome-subtexto\">Prof. Diego</div>\n                            </div>\n                            <div class=\"class-title\" id=\"prof-turma-titulo\">6º ANO A</div>\n                            <div style=\"display:flex; align-items:center; gap:12px;\">\n                                <div class=\"clock-tag\"><i class=\"ph-bold ph-clock\"></i> <span id=\"relogio-prof-dark\">08:15</span></div>\n                            </div>\n                        </div>\n\n                        <!-- Banner Lousa / Professor -->\n                        <div style=\"background:#1E293B; color:#94A3B8; text-align:center; padding:10px; border-radius:12px; font-weight:800; font-size:12px; margin-bottom:16px; border:1px dashed #334155;\">\n                            <i class=\"ph-bold ph-chalkboard-teacher\" style=\"color:var(--rodin-orange); margin-right:6px;\"></i> LOUSA / PROFESSOR (FRENTE DA SALA)\n                        </div>\n\n                        <!-- Grid de Carteiras do Mapa de Sala -->\n                        <div id=\"prof-photocards-grid\" class=\"photocards-grid\"></div>\n                    </div>\n                </div>\n\n            </div>\n        </main>\n    </div>\n\n    <!-- MODAL 1: LISTA COMPLETA DE OCORRÊNCIAS DO ALUNO -->\n    <div id=\"modal-ocorrencia-rodin\" class=\"modal-overlay\" style=\"display:none;\">\n        <div class=\"modal-container-rodin\" style=\"position:relative;\">\n            <button onclick=\"fecharModalOcorrenciaRodin()\" class=\"btn-close-dark-round\" title=\"Fechar\" style=\"position:absolute; top:20px; right:20px; z-index:10;\">&times;</button>\n            \n            <div class=\"modal-student-header\">\n                <img id=\"rodin-modal-avatar\" src=\"\" alt=\"Foto Aluno\">\n                <h2 id=\"rodin-modal-nome\">Aluno</h2>\n                <span id=\"rodin-modal-turma\" class=\"student-turma-badge\">6º ANO A</span>\n            </div>\n\n            <div id=\"rodin-options-list\" class=\"rodin-options-list\"></div>\n        </div>\n    </div>\n\n    <!-- MODAL 3: EXPLICAÇÃO E GUIA DA OCORRÊNCIA (ÍCONE DE INFORMAÇÕES i) -->\n    <div id=\"modal-info-ocorrencia\" class=\"modal-overlay\" style=\"display:none; z-index: 10010;\">\n        <div class=\"modal-container-popup\" style=\"max-width: 480px; width:92%; background:#0F172A; color:#FFF; border-radius:24px; padding:24px; border:1px solid #334155; position:relative;\">\n            <button onclick=\"fecharModalInfoOcorrencia()\" class=\"btn-close-dark-round\" title=\"Fechar\" style=\"position:absolute; top:20px; right:20px; z-index:10;\">&times;</button>\n            \n            <div style=\"display:flex; align-items:center; gap:10px; margin-bottom:14px;\">\n                <div style=\"width:36px; height:36px; border-radius:10px; background:rgba(255,107,0,0.15); border:1px solid rgba(255,107,0,0.3); display:flex; align-items:center; justify-content:center; color:var(--rodin-orange); font-size:20px;\">\n                    <i class=\"ph-bold ph-info\"></i>\n                </div>\n                <h3 id=\"info-oc-titulo\" style=\"font-size:16px; font-weight:800; color:#FFF; margin:0;\">Informações da Ocorrência</h3>\n            </div>\n\n            <div style=\"background:#1E293B; border-radius:14px; padding:14px; border:1px solid #334155; margin-bottom:16px;\">\n                <strong style=\"font-size:11px; text-transform:uppercase; color:var(--rodin-orange); letter-spacing:0.5px; display:block; margin-bottom:6px;\">Definição & Orientação Pedagógica:</strong>\n                <p id=\"info-oc-definicao\" style=\"font-size:13px; color:#E2E8F0; margin:0 0 10px 0; line-height:1.5;\"></p>\n                <div id=\"info-oc-orientacao\" style=\"font-size:12px; color:#94A3B8; background:rgba(0,0,0,0.2); padding:10px; border-radius:8px; border-left:3px solid var(--rodin-orange);\"></div>\n            </div>\n\n            <div id=\"info-oc-stats-box\" style=\"margin-bottom:20px;\"></div>\n\n            <div style=\"display:flex; gap:12px;\">\n                <button type=\"button\" class=\"btn-primary-rodin\" id=\"btn-info-registrar-agora\" onclick=\"confirmarRegistroViaModalInfo()\" style=\"flex:1; justify-content:center;\">\n                    <i class=\"ph-bold ph-check-circle\" style=\"font-size:18px;\"></i> Registrar Ocorrência\n                </button>\n                <button type=\"button\" class=\"btn-dark-cancel\" onclick=\"fecharModalInfoOcorrencia()\" style=\"flex:1;\">Fechar</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- MODAL 2: POP-UP SECUNDÁRIO DE RELATO E ÁUDIO (OPÇÕES VERMELHAS) -->\n    <div id=\"modal-detalhes-audio\" class=\"modal-overlay\" style=\"display:none; z-index: 10015;\">\n        <div class=\"modal-container-popup\" style=\"max-width: 500px; width:92%; background:#0F172A; color:#FFF; border-radius:24px; padding:24px; border:1.5px solid var(--rodin-orange); position:relative; box-shadow:0 25px 60px rgba(0,0,0,0.7);\">\n            <button onclick=\"fecharModalDetalhesAudio()\" class=\"btn-close-dark-round\" title=\"Fechar\" style=\"position:absolute; top:20px; right:20px; z-index:10;\">&times;</button>\n            \n            <div style=\"display:flex; align-items:center; gap:10px; margin-bottom:12px;\">\n                <div style=\"width:36px; height:36px; border-radius:10px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); display:flex; align-items:center; justify-content:center; color:#EF4444; font-size:20px;\">\n                    <i class=\"ph-bold ph-warning-octagon\"></i>\n                </div>\n                <h3 id=\"popup-title\" style=\"font-size:17px; font-weight:800; color:#FFF; margin:0;\">⚠️ Alteração Comportamental</h3>\n            </div>\n            \n            <p id=\"popup-description\" style=\"font-size:13px; color:#94A3B8; margin-bottom:16px; line-height:1.4;\">\n                Por favor, relate brevemente os detalhes ou sintomas observados.\n            </p>\n\n            <div style=\"margin-bottom: 16px;\">\n                <textarea id=\"popup-textarea\" rows=\"4\" placeholder=\"Descreva o comportamento observado...\" style=\"width:100%; background:#1E293B; border:1px solid #334155; border-radius:14px; padding:12px; color:#FFF; font-size:13px; font-family:inherit; outline:none; resize:vertical; box-sizing:border-box;\"></textarea>\n            </div>\n\n            <div class=\"audio-recorder-box\" style=\"background:#1E293B; border:1px solid #334155; border-radius:14px; padding:14px; margin-bottom:20px;\">\n                <label style=\"display:flex; align-items:center; gap:8px; font-size:13px; color:#FFF; font-weight:700; margin-bottom:10px;\">\n                    <i class=\"ph-bold ph-microphone\" style=\"color:var(--rodin-orange); font-size:18px;\"></i> Gravar Relato em Áudio\n                </label>\n\n                <div class=\"mic-recorder-row\" style=\"display:flex; align-items:center; gap:12px;\">\n                    <button type=\"button\" id=\"btn-mic-record\" onclick=\"alternarGravacaoAudio()\" class=\"btn-mic-pulse\" style=\"width:44px; height:44px; border-radius:50%; background:var(--rodin-orange); border:none; color:#FFF; font-size:20px; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.2s ease; box-shadow:0 4px 12px rgba(255,107,0,0.4);\">\n                        <i class=\"ph-bold ph-microphone\"></i>\n                    </button>\n                    <span id=\"mic-status-text\" style=\"font-size:12px; color:#94A3B8; font-weight:600;\">Clique no microfone para iniciar</span>\n                </div>\n            </div>\n\n            <div class=\"popup-actions\" style=\"display:flex; gap:12px;\">\n                <button type=\"button\" class=\"btn-primary-rodin\" onclick=\"confirmarRegistroDetalhadoAudio()\" style=\"flex:1; justify-content:center;\">\n                    <i class=\"ph-bold ph-check-circle\" style=\"font-size:18px;\"></i> Confirmar Registro\n                </button>\n                <button type=\"button\" class=\"btn-dark-cancel\" onclick=\"fecharModalDetalhesAudio()\" style=\"flex:1;\">Cancelar</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- MODAL 5: DESBLOQUEIO COM ANIMAÇÃO APPLE FACE ID (DURANTE USO DO APP) -->\n    <div id=\"modal-login-facial\" class=\"modal-overlay\" style=\"display:none; z-index: 10020;\">\n        <div class=\"modal-container-apple-faceid\" style=\"max-width: 360px; width:90%; background:rgba(15, 23, 42, 0.94); color:#FFF; border-radius:32px; padding:32px 24px; border:1px solid rgba(255, 255, 255, 0.12); text-align:center; display:flex; flex-direction:column; align-items:center; position:relative; backdrop-filter:blur(20px); box-shadow:0 30px 70px rgba(0,0,0,0.8); animation: appleModalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);\">\n            <button onclick=\"fecharModalLoginFacial()\" class=\"btn-close-dark-round\" title=\"Fechar\" style=\"position:absolute; top:18px; right:18px; z-index:10;\">&times;</button>\n\n            <!-- Video oculto para streaming de biometria de fundo -->\n            <video id=\"video-login-facial\" autoplay muted playsinline style=\"display:none;\"></video>\n\n            <!-- Scanner Animado Estilo Apple Face ID -->\n            <div class=\"apple-faceid-scanner-container\">\n                <div class=\"apple-faceid-frame\" id=\"apple-faceid-frame\">\n                    <span class=\"corner top-left\"></span>\n                    <span class=\"corner top-right\"></span>\n                    <span class=\"corner bottom-left\"></span>\n                    <span class=\"corner bottom-right\"></span>\n                    \n                    <div class=\"apple-laser-line\" id=\"apple-laser-line\"></div>\n\n                    <!-- Ícone Central Rosto Apple -->\n                    <div class=\"apple-face-icon\" id=\"apple-face-icon\">\n                        <i class=\"ph-bold ph-smiley-wink\" id=\"apple-icon-symbol\"></i>\n                    </div>\n                </div>\n            </div>\n\n            <h3 style=\"font-size:18px; font-weight:800; color:#FFF; margin-top:20px; margin-bottom:6px; text-align:center; letter-spacing:-0.2px;\">Face ID</h3>\n            <p id=\"face-liveness-status\" style=\"font-size:12.5px; color:#94A3B8; margin:0; text-align:center; line-height:1.4;\">\n                Escaneando biometria facial...\n            </p>\n        </div>\n    </div>\n\n\n\n    <!-- MODAL DE TROCA DE AULA (ALERTA PEDAGÓGICO) -->\n    <div id=\"modal-troca-aula\" class=\"modal-overlay\" style=\"display:none; z-index: 10025;\">\n        <div class=\"modal-container-popup\" style=\"max-width: 480px; width:92%; background:#FFFFFF; border-radius:24px; padding:28px; text-align:center; box-shadow:0 25px 50px -12px rgba(0,0,0,0.4);\">\n            <div style=\"width:64px; height:64px; background:#FFF0E6; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px auto;\">\n                <i class=\"ph-bold ph-arrows-clockwise\" style=\"font-size:32px; color:var(--rodin-orange);\"></i>\n            </div>\n            <h3 style=\"font-size:18px; font-weight:900; color:var(--rodin-graphite); margin-bottom:8px;\">⚠️ Troca de Aula Detectada</h3>\n            <p style=\"font-size:13px; color:var(--rodin-cool-gray); line-height:1.5; margin-bottom:20px;\">\n                Uma nova aula foi iniciada. Por favor, <strong>confira o Mapa de Sala</strong> e verifique se os alunos estão ocupando suas carteiras indicadas antes de dar início à aula.\n            </p>\n            <button type=\"button\" class=\"btn-primary-rodin\" onclick=\"confirmarTrocaAulaMapa()\" style=\"width:100%; justify-content:center; padding:12px; font-size:13px;\">\n                <i class=\"ph-bold ph-check-circle\"></i> Conferir Mapa e Iniciar Aula\n            </button>\n        </div>\n    </div>\n    <!-- BLOQUEIO TOTAL DE DISPOSITIVO NO PRIMEIRO ACESSO (PROTEÇÃO CONTRA CURIOSOS) -->\n    <div id=\"full-screen-device-lock\" style=\"display:none; position:fixed; inset:0; background:#0F172A; z-index:100000; flex-direction:column; align-items:center; justify-content:center; padding:24px; text-align:center; color:#FFF;\">\n        <div style=\"max-width:500px; width:92%; background:#1E293B; border-radius:28px; padding:32px 24px; border:2px solid var(--rodin-orange); box-shadow:0 30px 60px rgba(0,0,0,0.6); display:flex; flex-direction:column; align-items:center;\">\n            \n            <div style=\"width:68px; height:68px; background:rgba(244, 82, 6, 0.15); border-radius:50%; display:flex; align-items:center; justify-content:center; margin-bottom:16px;\">\n                <i class=\"ph-bold ph-shield-check\" style=\"font-size:36px; color:var(--rodin-orange);\"></i>\n            </div>\n\n            <h2 style=\"font-size:22px; font-weight:900; color:#FFF; margin-bottom:8px;\">Acesso Restrito ao Tablet de Sala</h2>\n            <p style=\"font-size:13px; color:#94A3B8; line-height:1.5; margin-bottom:20px;\">\n                Este dispositivo exige a <strong>Leitura Facial do Professor</strong> no primeiro acesso para proteger as informações dos alunos.\n            </p>\n\n            <div class=\"face-camera-wrapper\" style=\"margin:0 auto 16px auto;\">\n                <video id=\"video-device-lock\" autoplay muted playsinline></video>\n                <div class=\"face-oval-guide pulse\"></div>\n            </div>\n\n            <div id=\"device-lock-status-text\" class=\"liveness-status-box\" style=\"width:100%; box-sizing:border-box;\">\n                Aproxime seu rosto da câmera para autenticar este dispositivo...\n            </div>\n\n            <button type=\"button\" id=\"btn-device-lock-scan\" class=\"btn-primary-rodin\" onclick=\"executarScanAutenticacaoDispositivo()\" style=\"width:100%; justify-content:center; margin-top:20px; padding:14px; font-size:14px; gap:8px;\">\n                <i class=\"ph-bold ph-scan\" style=\"font-size:22px;\"></i> Autenticar Dispositivo via Leitura Facial\n            </button>\n        </div>\n    </div>\n\n    <!-- MODAL DE ALERTA DE SEGURANÇA (FACIAL FAIL) -->\n    <div id=\"modal-alerta-seguranca\" class=\"modal-overlay\" style=\"display:none; z-index: 200010;\">\n        <div class=\"modal-container-popup\" style=\"max-width: 440px; width:92%; background:#131C2E; border-radius:24px; padding:32px 28px; text-align:center; box-shadow:0 25px 50px -12px rgba(0,0,0,0.6); border: 2px solid #EF4444; color: #FFF; font-family:'Outfit', sans-serif;\">\n            <div style=\"width:64px; height:64px; background:rgba(239, 68, 68, 0.15); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px auto; border: 1px solid rgba(239, 68, 68, 0.3);\">\n                <i class=\"ph-bold ph-shield-warning\" style=\"font-size:32px; color:#EF4444;\"></i>\n            </div>\n            <h3 style=\"font-size:20px; font-weight:800; color:#FFF; margin:0 0 10px 0;\">Segurança Ativada</h3>\n            <p style=\"font-size:13px; color:#94A3B8; line-height:1.5; margin:0 0 24px 0;\">\n                Foram detectadas <strong>3 tentativas consecutivas incorretas</strong> no Face ID.<br>Por segurança, o painel foi bloqueado e requer reautenticação da monitoria.\n            </p>\n            <button type=\"button\" class=\"btn-primary-rodin\" onclick=\"fecharAlertaSeguranca()\" style=\"width:100%; justify-content:center; padding:12px; font-size:13px; background:#EF4444; border-color:#EF4444; color:#FFF; border-radius:12px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:8px;\">\n                <i class=\"ph-bold ph-key\"></i> Autenticar Monitoria\n            </button>\n        </div>\n    </div>\n\n    <!-- OVERLAY DE LOGIN SEGURO PARA A MONITORIA / SALA DE AULA -->\n    <div id=\"sala-login-overlay\" style=\"position:fixed; inset:0; background:#0B0F19; z-index:200000; display:flex; align-items:center; justify-content:center; padding:20px; font-family:'Outfit', sans-serif;\">\n        <div style=\"background:#131C2E; max-width:400px; width:100%; padding:36px 28px; border-radius:24px; border:1px solid #1E293B; text-align:center; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);\">\n            <div style=\"width:56px; height:56px; background:rgba(255,107,0,0.1); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px auto; border:1px solid rgba(255,107,0,0.2);\">\n                <i class=\"ph-bold ph-shield-check\" style=\"font-size:28px; color:var(--rodin-orange);\"></i>\n            </div>\n            <h2 style=\"font-size:20px; font-weight:800; color:#FFFFFF; margin:0 0 6px 0;\">Acesso à Sala de Aula</h2>\n            <p style=\"font-size:12.5px; color:#94A3B8; margin:0 0 24px 0; line-height:1.5;\">Este dispositivo está restrito. Insira as credenciais autorizadas para visualizar o mapa de sala.</p>\n            \n            <form id=\"sala-login-form\" onsubmit=\"validarLoginMonitoria(event)\" style=\"text-align:left; display:flex; flex-direction:column; gap:14px;\">\n                <div>\n                    <label style=\"display:block; font-size:10px; font-weight:700; color:#E2E8F0; text-transform:uppercase; margin-bottom:5px; letter-spacing:0.5px;\">Usuário</label>\n                    <input type=\"text\" id=\"sala-login-user\" required autocomplete=\"off\" placeholder=\"Digite o usuário\" style=\"width:100%; background:#1E293B; border:1px solid #334155; border-radius:12px; padding:11px 14px; color:#FFFFFF; font-size:13.5px; outline:none; box-sizing:border-box;\">\n                </div>\n                <div>\n                    <label style=\"display:block; font-size:10px; font-weight:700; color:#E2E8F0; text-transform:uppercase; margin-bottom:5px; letter-spacing:0.5px;\">Senha</label>\n                    <input type=\"password\" id=\"sala-login-pass\" required autocomplete=\"off\" placeholder=\"Digite a senha\" style=\"width:100%; background:#1E293B; border:1px solid #334155; border-radius:12px; padding:11px 14px; color:#FFFFFF; font-size:13.5px; outline:none; box-sizing:border-box;\">\n                </div>\n                <div id=\"sala-login-error\" style=\"color:#EF4444; font-size:11.5px; font-weight:600; text-align:center; display:none; margin-top:2px;\">\n                    ⚠️ Usuário ou senha incorretos!\n                </div>\n                <button type=\"submit\" style=\"width:100%; justify-content:center; padding:12px; font-size:13px; margin-top:6px; background:var(--rodin-orange); color:#FFF; border:none; border-radius:12px; cursor:pointer; font-weight:700; display:flex; align-items:center; gap:8px;\">\n                    <i class=\"ph-bold ph-sign-in\" style=\"font-size:18px;\"></i> Desbloquear Sala\n                </button>\n            </form>\n        </div>\n    </div>\n\n    <!-- SCRIPTS -->\n    <script src=\"global.js\"></script>\n    <script src=\"sidebar.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/vision_bundle.js\" crossorigin=\"anonymous\"></script>\n    <script src=\"face_security.js\"></script>\n    <script src=\"app.js\"></script>\n    <script>\n        function aplicarRestricoesMonitoria() {\n            // Ocultar barra lateral incondicionalmente para o perfil de sala\n            const sidebar = document.getElementById('sidebar-secondary');\n            if (sidebar) {\n                sidebar.style.setProperty('display', 'none', 'important');\n            }\n            \n            // Forçar a tela principal a ocupar 100% de largura\n            const mainContent = document.querySelector('.main-content');\n            if (mainContent) {\n                mainContent.style.marginLeft = '0';\n                mainContent.style.width = '100%';\n                mainContent.style.maxWidth = '100%';\n            }\n            \n            const viewScroll = document.getElementById('view-scroll-container');\n            if (viewScroll) {\n                viewScroll.style.padding = '0';\n            }\n        }\n\n        function validarLoginMonitoria(event) {\n            event.preventDefault();\n            const user = (document.getElementById('sala-login-user').value || '').trim();\n            const pass = (document.getElementById('sala-login-pass').value || '');\n            const errorEl = document.getElementById('sala-login-error');\n            \n            if (user === 'monitoria' && pass === 'Rod!n112358*') {\n                sessionStorage.setItem('rodin_sala_auth', 'true');\n                sessionStorage.setItem('rodin_user_role', 'monitoria');\n                localStorage.setItem('rodin_sala_auth', 'true');\n                localStorage.setItem('rodin_user_role', 'monitoria');\n                \n                const overlay = document.getElementById('sala-login-overlay');\n                if (overlay) overlay.style.setProperty('display', 'none', 'important');\n                \n                const layout = document.getElementById('app-layout');\n                if (layout) layout.style.display = 'flex';\n                \n                aplicarRestricoesMonitoria();\n                carregarMapaProfessor();\n            } else {\n                if (errorEl) {\n                    errorEl.style.display = 'block';\n                    setTimeout(() => { errorEl.style.display = 'none'; }, 3000);\n                }\n            }\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const hasSalaAuth = sessionStorage.getItem('rodin_sala_auth') === 'true' || localStorage.getItem('rodin_sala_auth') === 'true';\n            \n            const overlay = document.getElementById('sala-login-overlay');\n            const layout = document.getElementById('app-layout');\n            \n            if (hasSalaAuth) {\n                if (overlay) overlay.style.setProperty('display', 'none', 'important');\n                if (layout) layout.style.display = 'flex';\n                aplicarRestricoesMonitoria();\n                carregarMapaProfessor();\n            } else {\n                if (overlay) overlay.style.display = 'flex';\n                if (layout) layout.style.setProperty('display', 'none', 'important');\n            }\n        });\n    </script>\n</body>\n</html>\n"}]}